# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Flask Configuration
FLASK_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///bot_data.db

# Voice Transcription API Keys (Optional - for voice message feature)
# Primary services (recommended)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
GOOGLE_APPLICATION_CREDENTIALS_JSON=your_google_credentials_json_here
OPENAI_API_KEY=your_openai_api_key_here

# Note: Voice transcription works without these API keys, but will show an error
# message when users send voice messages. Add at least one key to enable the feature.
#
# Recommended setup:
# 1. Get OpenAI API key (Whisper model) - https://platform.openai.com/api-keys
# 2. Get AssemblyAI API key (free tier available) - https://www.assemblyai.com/
# 3. Or set up Google Cloud Speech-to-Text - https://cloud.google.com/speech-to-text
# 4. Fallback services will be used if primary services fail

# Optional: Hugging Face API Token (for premium translations - legacy)
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here

# SonarQube Configuration (for code quality analysis)
SONAR_TOKEN=your_sonarqube_token_here
SONAR_TOKEN_VS_CODE=your_sonarqube_vs_code_token_here

# Railway Token used by MCP Servers
RAILWAY_TOKEN=your_railway_token_here

# Optional: Database URL for production (Railway/Render/Heroku will set this automatically)
# DATABASE_URL=postgresql://username:password@host:port/database_name
