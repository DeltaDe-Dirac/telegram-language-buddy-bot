{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn src.main:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "pr": {
      "variables": {
        "TELEGRAM_BOT_TOKEN": "${{ TELEGRAM_BOT_TOKEN_STAGE }}",
        "IS_PR_BUILD": "true"
      }
    }
  }
}
